   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "#Data for the pie chart\n",
    "lable = ['Apples' , 'Bananas' , 'Cherries' , 'Grapes']\n",
    "size = [15,30,45,10]\n",
    "\n",
    "#Plotting the pie chart\n",
    "plt.pie(size , labels=lable , autopct='%1.1f%%', startangle= 90 )\n",
    "\n",
    "plt.axis ('equal')\n",
    "\n",
    "#Display the chart\n",
    "plt.show()"
   ]
  }
 ],
